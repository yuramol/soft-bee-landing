APP_NAME=softbee-landing


##############
# SUPABASE LOCAL (supabase start — same machine as CLI output)
##############
SUPABASE_PROJECT_ID=
SUPABASE_URL=http://localhost:54321
SUPABASE_REST_URL=http://localhost:54321/rest/v1
SUPABASE_GRAPHQL_URL=http://localhost:54321/graphql/v1
SUPABASE_FUNCTIONS_URL=http://localhost:54321/functions/v1
SUPABASE_MCP_URL=http://localhost:54321/mcp
SUPABASE_STUDIO_URL=http://localhost:54323
SUPABASE_MAILPIT_URL=http://localhost:54324
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_S3_URL=http://localhost:54321/storage/v1/s3
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_REGION=local

# Point the Next.js app at the local stack (e.g. in .env.local or temporarily here):
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
# Server-only. Used for estimation_logs writes (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=


##############
# SITE SECURITY (shared: estimation + contact forms) — server-only
##############
# HMAC for signed cookies (ownership, poll rate, contact rate limit). Required in all envs.
# e.g. openssl rand -base64 32
SITE_HMAC_SECRET=
# Comma-separated allowlist, e.g. https://softbee.io,https://www.softbee.io
# Localhost is always allowed when NODE_ENV=development.
SITE_ALLOWED_ORIGINS=

# reCAPTCHA v3 (invisible). Site key is public; secret stays server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=


##############
# SMART ESTIMATOR (Railway) — server-only
# Set the same keys in .env.local and Vercel Project Env.
##############
ESTIMATOR_BASE_URL=
ESTIMATOR_API_KEY=
# Comma-separated allowlist of hostnames for download redirects (SSRF protection).
# e.g. railway.app,s3.amazonaws.com,storage.googleapis.com
# Empty = fail closed (reject all redirects). Local/dev can leave empty or add test hosts.
ESTIMATOR_DOWNLOAD_HOST_ALLOWLIST=


##############
# CONTACT FORMS (Resend) — Discuss Project + Careers Apply
# Server-only except shared reCAPTCHA site key above.
##############
RESEND_API_KEY=
# Verified sender in Resend, e.g. Soft Bee <noreply@yourdomain.com>
CONTACT_FROM_EMAIL=
# Inbox that receives form submissions (defaults to hello@softbee.com)
CONTACT_TO_EMAIL=hello@softbee.com
